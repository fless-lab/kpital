<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <span class="footer-logo">
          <svg class="footer-logo-mark" viewBox="8 10 32 35" aria-hidden="true">
            <ellipse filter="url(#kp-sh)" cx="24" cy="37.5" rx="12.5" ry="5" fill="url(#kp-lo)"/>
            <ellipse filter="url(#kp-sh)" cx="22.5" cy="29.8" rx="10" ry="4.6" fill="url(#kp-hi)"/>
            <ellipse filter="url(#kp-sh)" cx="25.5" cy="22.7" rx="8" ry="4.1" fill="url(#kp-lo)"/>
            <ellipse filter="url(#kp-sh)" cx="23.5" cy="16.3" rx="5.6" ry="3.5" fill="url(#kp-hi)"/>
          </svg>
          KPITAL
        </span>
        <p class="footer-tagline">{{ t[lang].footer.tagline }}</p>
        <div class="footer-semoa">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          {{ t[lang].footer.secured }}
        </div>
      </div>
      <div class="footer-col">
        <h4>{{ t[lang].footer.platform }}</h4>
        <ul>
          <li><a href="{{ langPrefix }}/projets">{{ t[lang].footer.projets }}</a></li>
          <li><a href="{{ langPrefix }}/comment-ca-marche">{{ t[lang].footer.comment }}</a></li>
          <li><a href="{{ langPrefix }}/securite">{{ t[lang].footer.securite }}</a></li>
          <li><a href="{{ langPrefix }}/soumettre">{{ t[lang].footer.soumettre }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t[lang].footer.investors }}</h4>
        <ul>
          <li><a href="{{ langPrefix }}/inscription">{{ t[lang].footer.inscription }}</a></li>
          <li><a href="{{ langPrefix }}/connexion">{{ t[lang].footer.connexion }}</a></li>
          <li><a href="{{ langPrefix }}/#diaspora">{{ t[lang].footer.diaspora }}</a></li>
          <li><a href="{{ langPrefix }}/faq">{{ t[lang].footer.faq }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t[lang].footer.company }}</h4>
        <ul>
          <li><a href="{{ langPrefix }}/a-propos">{{ t[lang].footer.apropos }}</a></li>
          <li><a href="{{ langPrefix }}/contact">{{ t[lang].footer.contact }}</a></li>
          <li><a href="{{ langPrefix }}/partenaires">{{ t[lang].footer.partenaires }}</a></li>
          <li><a href="{{ langPrefix }}/rejoindre">{{ t[lang].footer.rejoindre }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">{{ t[lang].footer.copy }}</span>
      <div class="footer-legal">
        <a href="{{ langPrefix }}/conditions">{{ t[lang].footer.conditions }}</a>
        <a href="{{ langPrefix }}/confidentialite">{{ t[lang].footer.confidentialite }}</a>
        <a href="{{ langPrefix }}/mentions-legales">{{ t[lang].footer.mentions }}</a>
      </div>
    </div>
  </div>
</footer>
