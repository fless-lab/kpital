DATABASE_URL=postgres://user:password@localhost:5432/kpital
SESSION_COOKIE_NAME=kpital_sess
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
NOTIFY_CHANNELS=email
CORS_ORIGIN=http://localhost:8080
# TRUST_PROXY: off by default. Behind a reverse proxy set TRUST_PROXY=1 (trust
# exactly one hop) so /auth rate-limiting keys on the real client IP.
TRUST_PROXY=false
# MinIO / object storage for KYC documents
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=kpital
MINIO_SECRET_KEY=kpital-secret
MINIO_BUCKET=kpital-kyc
MINIO_REGION=us-east-1
# KYC: presigned URL TTL (seconds) and max upload size (MB)
KYC_URL_TTL_SECONDS=120
KYC_MAX_FILE_MB=10
